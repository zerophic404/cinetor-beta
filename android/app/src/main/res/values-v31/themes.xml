<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: platform SplashScreen plays the animated vector (ring draw + play pop). -->
    <style name="Theme.Cinetor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Cinetor</item>
    </style>
</resources>
